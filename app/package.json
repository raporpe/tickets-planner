{
  "name": "tickets-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local web UI to review Azure DevOps tickets and plan sprints",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "vite build && node server/index.js"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@github/copilot-sdk": "^1.0.28",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.5"
  }
}
