{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tickets planner",
  "version": "0.2.5",
  "identifier": "com.raulpo.tickets-planner",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "create": false,
      "title": "Tickets planner",
      "width": 1440,
      "height": 960,
      "minWidth": 720,
      "minHeight": 480
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src ipc: http://ipc.localhost http://127.0.0.1:5173 ws://127.0.0.1:5173; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    },
    "macOS": { "minimumSystemVersion": "11.0" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBOTYzMjE3OTBCRTY3NzAKUldSd1o3NlFGektXZWxFMmJsb1VzTWJ1bnhKTktZR0FkdytidE9ubG5YMkhlSjB2Y0pBa0w5UWkK",
      "endpoints": [
        "https://stticketsplanner9284.blob.core.windows.net/releases/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
